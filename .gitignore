# =====================================================================
#  CONTENIDO PERSONAL DE CADA USUARIO — nunca se sube ni se sobrescribe
#  (las carpetas se suben vacías, solo con su LEEME.md)
# =====================================================================
MI_*.md
!MI_CANAL.ejemplo.md
mi_config.json

# Analizador: videos de otros creadores y resultados con sus imágenes (las fórmulas de Estilos/ SÍ se comparten)
Analizador/Videos_para_analizar/*
!Analizador/Videos_para_analizar/LEEME.md
Analizador/Resultados/*
!Analizador/Resultados/LEEME.md

# Personajes de cada usuario (y rigs/caras con licencia de Roblox)
Personajes/Protagonista/*
!Personajes/Protagonista/LEEME.md
Personajes/Secundarios/*
!Personajes/Secundarios/LEEME.md
Personajes/Pueblo_NPC/*
!Personajes/Pueblo_NPC/LEEME.md
Personajes/Plantillas_Rigs/*
!Personajes/Plantillas_Rigs/LEEME.md
Caras/*
!Caras/LEEME.md

# Escenarios propios (el Pueblo por defecto SÍ se comparte)
Escenarios/*
!Escenarios/LEEME.md
!Escenarios/Pueblo/

# Episodios de cada usuario (la plantilla SÍ se comparte)
Episodios/*
!Episodios/_PLANTILLA_EPISODIO/

Respaldos/*
!Respaldos/LEEME.md

# =====================================================================
#  Archivos generados
# =====================================================================
*.blend1
*.blend2
__pycache__/
*.pyc
renders/
pruebas_pose/
previews/
*.wav
*.mp4
*.mp3
Thumbs.db
desktop.ini

# Estilo propio de cada usuario (sus episodios analizados)
Analizador/Estilos/Nosotros*
